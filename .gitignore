# build/* y no build/: git no re-incluye nada dentro de un directorio
# excluido, así que con build/ las dos excepciones de abajo no surtían efecto.
build/*
!build/index.json
!build/atlas-inject.html
__pycache__/
*.pyc
.DS_Store
.claude/*
# La skill de Ghost se versiona para Claude Code (y en .agents/ para Codex);
# settings.local.json y el resto de .claude/ siguen ignorados.
!.claude/skills/
tmp/
output/
.venv/
